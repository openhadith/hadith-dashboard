# The hadith API: corpus reads, sign-in and publishing all go here.
# Local development uses the local API (hadith_platform_backend, `npm run dev:db`
# then `npm run dev`), never production — signing in and publishing act on
# whatever API this points at. Production sets https://api.openhadith.org/api.
# NEXT_PUBLIC_* values are compiled into the build, not read at runtime —
# changing one needs a rebuild (on Vercel: a redeploy), not just an edit.
NEXT_PUBLIC_API_URL=http://localhost:4005/api

# Dashboard's own database: workflow state, drafts, audit, teams.
STUDIO_DATABASE_URL=postgresql://localhost:5432/hadith_studio

# The public reading site, for "view on the public site" links.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Lists the seeded test accounts on /login (zana@muhaqqiq.org etc., password
# hadith-dev) so testers don't need credentials emailed to them. Local dev
# shows them automatically regardless. Leave unset for the real deployment.
# NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true
